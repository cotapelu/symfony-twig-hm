# Application Environment Variables for Docker Compose

# Database Configuration
POSTGRES_DB=phuongxa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Kafka Configuration
KAFKA_PORT=9092
KAFKA_CONTROLLER_PORT=9093

# RabbitMQ Configuration
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Backend Ports
PHP_PORT=8080
GO_PORT=8081
PYTHON_PORT=8002
KOTLIN_PORT=9000
ZIG_PORT=4000

# Application Environment
APP_ENV=dev
JWT_SECRET_KEY=your-secret-key-here-change-in-production
SENTRY_DSN=https://your-sentry-dsn

# Feature Flags
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true
ENABLE_MONITORING=true
LOG_LEVEL=info
