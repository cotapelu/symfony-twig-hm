{
    "name": "your-project/symfony-messaging",
    "description": "Symfony messaging platform with Svelte frontend",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "doctrine/annotations": "^2.0",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.5",
        "league/flysystem-aws-s3-v3": "^3.30",
        "league/flysystem-google-cloud-storage": "^3.30",
        "nelmio/api-doc-bundle": "^5.9",
        "ramsey/uuid": "^4.9",
        "sentry/sentry-symfony": "^5.0",
        "spatie/flysystem-dropbox": "^3.0",
        "symfony/cache": "^7.4",
        "symfony/console": "^7.4",
        "symfony/doctrine-bridge": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/mercure-bundle": "^0.4.2",
        "symfony/messenger": "^7.4",
        "symfony/monolog-bundle": "^3.11",
        "symfony/property-access": "^7.4",
        "symfony/rate-limiter": "^7.4",
        "symfony/runtime": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/serializer": "^7.4",
        "symfony/validator": "^7.4",
        "symfony/var-exporter": "^7.4",
        "symfony/webpack-encore-bundle": "^2.3",
        "symfony/yaml": "^7.4",
        "firebase/php-jwt": "^7.0",
        "aws/aws-sdk-php": "^3.371.3",
        "google/protobuf": "^4.33.6",
        "guzzlehttp/psr7": "^2.10.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-symfony": "^1.3",
        "phpunit/phpunit": "^12.5",
        "qossmic/deptrac": "^2.0",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/var-dumper": "^7.4",
        "symfony/webpack-encore-bundle": "^2.3"
    },
"autoload": {
    "psr-4": {
      "App\\": "src/",
      "App\\Modules\\": "src/Modules/",
      "App\\AppCore\\": "src/AppCore/",
      "Platform\\": "src/Platform/",
      "Module\\": "Module/",
      "DoctrineMigrations\\": "modules/Migrations/"
    },
    "classmap": [
      "modules/"
    ]
  },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
