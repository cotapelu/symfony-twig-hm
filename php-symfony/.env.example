### Symfony Configuration
APP_ENV=dev
# APP_SECRET should be set via environment variable or secret management system
APP_SECRET=${APP_SECRET:-}

### Database
# Database credentials should be set via environment variable or secret management system
DATABASE_HOST=${DATABASE_HOST:-localhost}
DATABASE_PORT=${DATABASE_PORT:-5432}
DATABASE_NAME=${DATABASE_NAME:-community_db}
DATABASE_USER=${DATABASE_USER:-}
DATABASE_PASSWORD=${DATABASE_PASSWORD:-}
DATABASE_VERSION=${DATABASE_VERSION:-15}
DATABASE_READ_USER=${DATABASE_READ_USER:-community_read}

### JWT
# JWT_SECRET should be set via environment variable or secret management system
JWT_SECRET=${JWT_SECRET:-}
JWT_TOKEN_TTL=${JWT_TOKEN_TTL:-86400}

### Biometric Encryption
# BIOMETRIC_ENCRYPTION_KEY should be set via environment variable or secret management system
BIOMETRIC_ENCRYPTION_KEY=${BIOMETRIC_ENCRYPTION_KEY:-}

### Mercure (Real-time)
MERCURE_URL=${MERCURE_URL:-http://localhost:3000/.well-known/mercure}
# MERCURE_PUBLIC_KEY should be set via environment variable or secret management system
MERCURE_PUBLIC_KEY=${MERCURE_PUBLIC_KEY:-}
# MERCURE_JWT_SECRET should be a random string of at least 32 characters for HS256
MERCURE_JWT_SECRET=${MERCURE_JWT_SECRET:-}
MERCURE_PUBLISH_URL=${MERCURE_PUBLISH_URL:-http://localhost:3000/.well-known/mercure}

### CORS
CORS_ALLOWED_ORIGINS=${CORS_ALLOWED_ORIGINS:-http://localhost:5173,http://localhost:3000}

### CSRF Protection
TRUSTED_ORIGINS=${TRUSTED_ORIGINS:-http://localhost:5173,http://localhost:3000,https://yourdomain.com}

### Internal Services
# Service URLs should be set via environment variable or service discovery
GO_SERVICE_URL=${GO_SERVICE_URL:-http://localhost:8080}
PYTHON_SERVICE_URL=${PYTHON_SERVICE_URL:-http://localhost:8000}
RUST_SERVICE_URL=${RUST_SERVICE_URL:-http://localhost:9000}
ZIG_SERVICE_URL=${ZIG_SERVICE_URL:-http://localhost:9001}
ELIXIR_SERVICE_URL=${ELIXIR_SERVICE_URL:-http://localhost:9002}

### File Upload
MAX_FILE_SIZE=${MAX_FILE_SIZE:-10485760}
ALLOWED_FILE_TYPES=${ALLOWED_FILE_TYPES:-jpg,jpeg,png,gif,pdf,doc,docx}

### OpenAI (AI Service)
# OPENAI_API_KEY should be set via environment variable or secret management system
OPENAI_API_KEY=${OPENAI_API_KEY:-}
OPENAI_MODEL=${OPENAI_MODEL:-gpt-3.5-turbo}
OPENAI_MAX_TOKENS=${OPENAI_MAX_TOKENS:-1000}

### Redis (Caching)
# REDIS_URL should be set via environment variable or secret management system if password protected
REDIS_URL=${REDIS_URL:-redis://localhost:6379}

### Rate Limiting
RATE_LIMIT_MAX_REQUESTS=${RATE_LIMIT_MAX_REQUESTS:-100}
RATE_LIMIT_PERIOD=${RATE_LIMIT_PERIOD:-60}

### Sentry (Error Tracking)
# SENTRY_DSN should be set via environment variable or secret management system
SENTRY_DSN=${SENTRY_DSN:-}
SENTRY_ENVIRONMENT=${SENTRY_ENVIRONMENT:-development}
