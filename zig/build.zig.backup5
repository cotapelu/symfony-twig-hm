const std = @import("std");

pub fn build(b: *std.Build) void {
    const target = b.standardTargetOptions(.{});
    const optimize = b.standardOptimizeOption(.{});

    // Main executable
    const exe = b.addExecutable(.{
        .name = "zig-app",
        .root_module = b.createModule(.{
            .root_source_file = b.path("main.zig"),
            .target = target,
            .optimize = optimize,
        }),
    });

    // Add modules
    const appcore_module = b.addModule("appcore", .{
        .root_source_file = b.path("modules/appcore.zig"),
    });
    exe.root_module.addImport("appcore", appcore_module);
       const sample_module = b.addModule("sample_module", .{
           .source_files = &.{
               b.path("modules/SampleModule/Api/sample_api.zig"),
               b.path("modules/SampleModule/Domain/sample_entity.zig"),
               b.path("modules/SampleModule/Application/sample_application_service.zig"),
               b.path("modules/SampleModule/Infrastructure/sample_repository.zig"),
               b.path("modules/SampleModule/Contracts/sample_service_interface.zig"),
           },
       });

    // Install
    b.installArtifact(exe);

    // Run command
    const run_cmd = b.addRunArtifact(exe);
    run_cmd.step.dependOn(b.getInstallStep());
       exe.root_module.addImport("sample_module", sample_module);
    if (b.args) |args| {
        run_cmd.addArgs(args);
    }
    const run_step = b.step("run", "Run the app");
    run_step.dependOn(&run_cmd.step);

    // Run tests
    const run_tests = b.step("test", "Run all tests");
    const test_exe = b.addTest(.{
        .root_module = b.createModule(.{
            .root_source_file = b.path("main_test.zig"),
            .target = target,
            .optimize = optimize,
        }),
    });
    test_exe.root_module.addImport("appcore", appcore_module);
    const run_test_cmd = b.addRunArtifact(test_exe);
    run_tests.dependOn(&run_test_cmd.step);
}
