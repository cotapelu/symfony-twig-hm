-- Migration: Create Python Schema
-- Description: Create python schema for analytics & AI tables

-- Create python schema
CREATE SCHEMA IF NOT EXISTS python;

-- Set search path
SET search_path TO python;

-- Event tables (from common schema)
CREATE TABLE IF NOT EXISTS python.event (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    event_type VARCHAR(100) NOT NULL,
    event_name VARCHAR(255) NOT NULL,
    properties JSONB,
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS python.event_store (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    aggregate_id UUID NOT NULL,
    aggregate_type VARCHAR(100) NOT NULL,
    event_type VARCHAR(100) NOT NULL,
    event_data JSONB NOT NULL,
    version INTEGER NOT NULL,
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Workflow instance table (from common schema)
CREATE TABLE IF NOT EXISTS python.workflow_instance (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    workflow_id UUID NOT NULL,
    user_id UUID,
    status VARCHAR(50) DEFAULT 'running',
    current_step VARCHAR(100),
    context JSONB,
    started_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    completed_at TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Analytics tables
CREATE TABLE IF NOT EXISTS python.analytics_event (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    event_type VARCHAR(100) NOT NULL,
    event_name VARCHAR(255) NOT NULL,
    properties JSONB,
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS python.analytics_aggregate (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    aggregate_type VARCHAR(100) NOT NULL,
    metric_name VARCHAR(255) NOT NULL,
    metric_value DECIMAL(20,2) NOT NULL,
    dimensions JSONB,
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ML tables
CREATE TABLE IF NOT EXISTS python.ml_model (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(255) NOT NULL,
    model_type VARCHAR(100) NOT NULL,
    version VARCHAR(50) NOT NULL,
    framework VARCHAR(50) NOT NULL,
    hyperparameters JSONB,
    metrics JSONB,
    status VARCHAR(50) DEFAULT 'training',
    model_path TEXT,
    training_progress DECIMAL(5,2) DEFAULT 0,
    error_message TEXT,
    base_model_id UUID REFERENCES python.ml_model(id) ON DELETE SET NULL,
    changes JSONB,
    training_data_config JSONB,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS python.ml_inference (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    model_id UUID NOT NULL REFERENCES python.ml_model(id) ON DELETE CASCADE,
    request_id VARCHAR(255) UNIQUE NOT NULL,
    input_data JSONB NOT NULL,
    output_data JSONB,
    confidence DECIMAL(5,4) NOT NULL,
    latency_ms INTEGER NOT NULL,
    status VARCHAR(50) DEFAULT 'pending',
    error_message TEXT,
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Recommendation table
CREATE TABLE IF NOT EXISTS python.recommendation (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    item_id VARCHAR(255) NOT NULL,
    item_type VARCHAR(100) NOT NULL,
    score DECIMAL(5,4) NOT NULL,
    reason TEXT,
    metadata JSONB,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Chatbot tables
CREATE TABLE IF NOT EXISTS python.chatbot_conversation (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    bot_type VARCHAR(100) NOT NULL,
    context JSONB,
    status VARCHAR(50) DEFAULT 'active',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS python.chatbot_interaction (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    conversation_id UUID NOT NULL REFERENCES python.chatbot_conversation(id) ON DELETE CASCADE,
    role VARCHAR(50) NOT NULL,
    message TEXT NOT NULL,
    metadata JSONB,
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Image recognition table
CREATE TABLE IF NOT EXISTS python.image_recognition_result (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    image_url TEXT NOT NULL,
    detected_objects JSONB NOT NULL,
    confidence DECIMAL(5,4) NOT NULL,
    model_version VARCHAR(50) NOT NULL,
    metadata JSONB,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Create indexes
CREATE INDEX idx_event_user_id ON python.event(user_id);
CREATE INDEX idx_event_type ON python.event(event_type);
CREATE INDEX idx_event_timestamp ON python.event(timestamp);
CREATE INDEX idx_event_store_aggregate_id ON python.event_store(aggregate_id);
CREATE INDEX idx_event_store_aggregate_type ON python.event_store(aggregate_type);
CREATE INDEX idx_event_store_version ON python.event_store(version);
CREATE INDEX idx_workflow_instance_workflow_id ON python.workflow_instance(workflow_id);
CREATE INDEX idx_workflow_instance_user_id ON python.workflow_instance(user_id);
CREATE INDEX idx_workflow_instance_status ON python.workflow_instance(status);
CREATE INDEX idx_analytics_event_user_id ON python.analytics_event(user_id);
CREATE INDEX idx_analytics_event_type ON python.analytics_event(event_type);
CREATE INDEX idx_analytics_event_timestamp ON python.analytics_event(timestamp);
CREATE INDEX idx_analytics_aggregate_type ON python.analytics_aggregate(aggregate_type);
CREATE INDEX idx_analytics_aggregate_timestamp ON python.analytics_aggregate(timestamp);
CREATE INDEX idx_ml_model_name ON python.ml_model(name);
CREATE INDEX idx_ml_model_type ON python.ml_model(model_type);
CREATE INDEX idx_ml_model_status ON python.ml_model(status);
CREATE INDEX idx_ml_inference_model_id ON python.ml_inference(model_id);
CREATE INDEX idx_ml_inference_request_id ON python.ml_inference(request_id);
CREATE INDEX idx_ml_inference_status ON python.ml_inference(status);
CREATE INDEX idx_ml_inference_timestamp ON python.ml_inference(timestamp);
CREATE INDEX idx_recommendation_user_id ON python.recommendation(user_id);
CREATE INDEX idx_recommendation_item_id ON python.recommendation(item_id);
CREATE INDEX idx_recommendation_item_type ON python.recommendation(item_type);
CREATE INDEX idx_chatbot_conversation_user_id ON python.chatbot_conversation(user_id);
CREATE INDEX idx_chatbot_conversation_bot_type ON python.chatbot_conversation(bot_type);
CREATE INDEX idx_chatbot_conversation_status ON python.chatbot_conversation(status);
CREATE INDEX idx_chatbot_interaction_conversation_id ON python.chatbot_interaction(conversation_id);
CREATE INDEX idx_chatbot_interaction_timestamp ON python.chatbot_interaction(timestamp);
CREATE INDEX idx_image_recognition_result_user_id ON python.image_recognition_result(user_id);
CREATE INDEX idx_image_recognition_result_image_url ON python.image_recognition_result(image_url);
CREATE INDEX idx_image_recognition_result_model_version ON python.image_recognition_result(model_version);

-- Create triggers for updated_at
CREATE OR REPLACE FUNCTION python.update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ language 'plpgsql';

CREATE TRIGGER update_workflow_instance_updated_at BEFORE UPDATE ON python.workflow_instance
    FOR EACH ROW EXECUTE FUNCTION python.update_updated_at_column();

CREATE TRIGGER update_ml_model_updated_at BEFORE UPDATE ON python.ml_model
    FOR EACH ROW EXECUTE FUNCTION python.update_updated_at_column();

CREATE TRIGGER update_chatbot_conversation_updated_at BEFORE UPDATE ON python.chatbot_conversation
    FOR EACH ROW EXECUTE FUNCTION python.update_updated_at_column();
