-- Migration: Create Go Schema
-- Description: Create go schema for financial services tables

-- Create go schema
CREATE SCHEMA IF NOT EXISTS go;

-- Set search path
SET search_path TO go;

-- Banking tables
CREATE TABLE IF NOT EXISTS go.banking_account (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    account_type VARCHAR(50) NOT NULL,
    currency VARCHAR(10) NOT NULL,
    balance DECIMAL(20,2) DEFAULT 0,
    status VARCHAR(50) DEFAULT 'active',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS go.banking_transaction (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    account_id UUID NOT NULL REFERENCES go.banking_account(id) ON DELETE CASCADE,
    transaction_type VARCHAR(50) NOT NULL,
    amount DECIMAL(20,2) NOT NULL,
    balance DECIMAL(20,2) NOT NULL,
    description TEXT,
    status VARCHAR(50) DEFAULT 'completed',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Crypto tables
CREATE TABLE IF NOT EXISTS go.crypto_wallet (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    wallet_type VARCHAR(50) NOT NULL,
    currency VARCHAR(10) NOT NULL,
    balance DECIMAL(20,2) DEFAULT 0,
    status VARCHAR(50) DEFAULT 'active',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS go.crypto_transaction (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    wallet_id UUID NOT NULL REFERENCES go.crypto_wallet(id) ON DELETE CASCADE,
    transaction_type VARCHAR(50) NOT NULL,
    amount DECIMAL(20,2) NOT NULL,
    balance DECIMAL(20,2) NOT NULL,
    tx_hash VARCHAR(255),
    address VARCHAR(255),
    description TEXT,
    status VARCHAR(50) DEFAULT 'completed',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Fraud tables
CREATE TABLE IF NOT EXISTS go.fraud_alert (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    alert_type VARCHAR(100) NOT NULL,
    severity VARCHAR(50) NOT NULL,
    description TEXT NOT NULL,
    status VARCHAR(50) DEFAULT 'open',
    assigned_to UUID,
    notes TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS go.fraud_rule (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    rule_name VARCHAR(255) NOT NULL,
    rule_type VARCHAR(100) NOT NULL,
    conditions JSONB NOT NULL,
    actions JSONB NOT NULL,
    enabled BOOLEAN DEFAULT true,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS go.fraud_evaluation (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    amount DECIMAL(20,2) NOT NULL,
    transaction_type VARCHAR(50) NOT NULL,
    risk_score INTEGER NOT NULL,
    risk_level VARCHAR(50) NOT NULL,
    decision VARCHAR(50) NOT NULL,
    reason TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Location tables
CREATE TABLE IF NOT EXISTS go.location (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    latitude DECIMAL(10,8) NOT NULL,
    longitude DECIMAL(11,8) NOT NULL,
    accuracy DECIMAL(10,2),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS go.geofence (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(255) NOT NULL,
    latitude DECIMAL(10,8) NOT NULL,
    longitude DECIMAL(11,8) NOT NULL,
    radius DECIMAL(10,2) NOT NULL,
    type VARCHAR(50) NOT NULL,
    enabled BOOLEAN DEFAULT true,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS go.geofence_event (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    geofence_id UUID NOT NULL REFERENCES go.geofence(id) ON DELETE CASCADE,
    event_type VARCHAR(50) NOT NULL,
    latitude DECIMAL(10,8) NOT NULL,
    longitude DECIMAL(11,8) NOT NULL,
    distance DECIMAL(10,2) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Create indexes
CREATE INDEX idx_banking_account_user_id ON go.banking_account(user_id);
CREATE INDEX idx_banking_account_status ON go.banking_account(status);
CREATE INDEX idx_banking_transaction_account_id ON go.banking_transaction(account_id);
CREATE INDEX idx_banking_transaction_type ON go.banking_transaction(transaction_type);
CREATE INDEX idx_crypto_wallet_user_id ON go.crypto_wallet(user_id);
CREATE INDEX idx_crypto_wallet_status ON go.crypto_wallet(status);
CREATE INDEX idx_crypto_transaction_wallet_id ON go.crypto_transaction(wallet_id);
CREATE INDEX idx_crypto_transaction_type ON go.crypto_transaction(transaction_type);
CREATE INDEX idx_fraud_alert_user_id ON go.fraud_alert(user_id);
CREATE INDEX idx_fraud_alert_status ON go.fraud_alert(status);
CREATE INDEX idx_fraud_alert_severity ON go.fraud_alert(severity);
CREATE INDEX idx_fraud_rule_enabled ON go.fraud_rule(enabled);
CREATE INDEX idx_fraud_evaluation_user_id ON go.fraud_evaluation(user_id);
CREATE INDEX idx_location_user_id ON go.location(user_id);
CREATE INDEX idx_location_created_at ON go.location(created_at);
CREATE INDEX idx_geofence_enabled ON go.geofence(enabled);
CREATE INDEX idx_geofence_event_user_id ON go.geofence_event(user_id);
CREATE INDEX idx_geofence_event_geofence_id ON go.geofence_event(geofence_id);

-- Create triggers for updated_at
CREATE OR REPLACE FUNCTION go.update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ language 'plpgsql';

CREATE TRIGGER update_banking_account_updated_at BEFORE UPDATE ON go.banking_account
    FOR EACH ROW EXECUTE FUNCTION go.update_updated_at_column();

CREATE TRIGGER update_crypto_wallet_updated_at BEFORE UPDATE ON go.crypto_wallet
    FOR EACH ROW EXECUTE FUNCTION go.update_updated_at_column();

CREATE TRIGGER update_fraud_alert_updated_at BEFORE UPDATE ON go.fraud_alert
    FOR EACH ROW EXECUTE FUNCTION go.update_updated_at_column();

CREATE TRIGGER update_fraud_rule_updated_at BEFORE UPDATE ON go.fraud_rule
    FOR EACH ROW EXECUTE FUNCTION go.update_updated_at_column();

CREATE TRIGGER update_geofence_updated_at BEFORE UPDATE ON go.geofence
    FOR EACH ROW EXECUTE FUNCTION go.update_updated_at_column();
