-- Migration: Create Kotlin Schema
-- Description: Create kotlin schema for system & monitoring tables

-- Create kotlin schema
CREATE SCHEMA IF NOT EXISTS kotlin;

-- Set search path
SET search_path TO kotlin;

-- Notification tables (from common schema)
CREATE TABLE IF NOT EXISTS kotlin.notification (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    type VARCHAR(50) NOT NULL,
    title VARCHAR(255) NOT NULL,
    message TEXT NOT NULL,
    data JSONB,
    status VARCHAR(50) DEFAULT 'pending',
    sent_at TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS kotlin.notification_channel (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    channel_type VARCHAR(50) NOT NULL,
    channel_config JSONB,
    enabled BOOLEAN DEFAULT true,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS kotlin.notification_template (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    template_code VARCHAR(50) UNIQUE NOT NULL,
    name VARCHAR(255) NOT NULL,
    subject VARCHAR(255),
    body TEXT NOT NULL,
    variables JSONB,
    status VARCHAR(50) DEFAULT 'active',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Media tables (from common schema)
CREATE TABLE IF NOT EXISTS kotlin.media_folder (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    parent_id UUID REFERENCES kotlin.media_folder(id) ON DELETE SET NULL,
    name VARCHAR(255) NOT NULL,
    path TEXT NOT NULL,
    level INTEGER DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS kotlin.media_file (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    folder_id UUID REFERENCES kotlin.media_folder(id) ON DELETE SET NULL,
    file_name VARCHAR(255) NOT NULL,
    file_path TEXT NOT NULL,
    file_size BIGINT NOT NULL,
    mime_type VARCHAR(100),
    file_type VARCHAR(50),
    metadata JSONB,
    status VARCHAR(50) DEFAULT 'active',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Payment tables
CREATE TABLE IF NOT EXISTS kotlin.payment (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    amount DECIMAL(20,2) NOT NULL,
    currency VARCHAR(10) NOT NULL,
    payment_method VARCHAR(50) NOT NULL,
    description TEXT,
    status VARCHAR(50) DEFAULT 'pending',
    transaction_id VARCHAR(255),
    error_message TEXT,
    refund_of UUID REFERENCES kotlin.payment(id) ON DELETE SET NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS kotlin.payment_intent (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    amount DECIMAL(20,2) NOT NULL,
    currency VARCHAR(10) NOT NULL,
    payment_method VARCHAR(50) NOT NULL,
    status VARCHAR(50) DEFAULT 'created',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Queue tables
CREATE TABLE IF NOT EXISTS kotlin.push_queue (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    title VARCHAR(255) NOT NULL,
    message TEXT NOT NULL,
    payload JSONB,
    priority VARCHAR(50) DEFAULT 'normal',
    status VARCHAR(50) DEFAULT 'pending',
    scheduled_at TIMESTAMP,
    sent_at TIMESTAMP,
    error_message TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS kotlin.email_queue (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    to_email VARCHAR(255) NOT NULL,
    subject VARCHAR(255) NOT NULL,
    body TEXT NOT NULL,
    html_body TEXT,
    priority VARCHAR(50) DEFAULT 'normal',
    status VARCHAR(50) DEFAULT 'pending',
    scheduled_at TIMESTAMP,
    sent_at TIMESTAMP,
    error_message TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Monitoring tables
CREATE TABLE IF NOT EXISTS kotlin.system_metric (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    metric_name VARCHAR(255) NOT NULL,
    metric_value DECIMAL(20,2) NOT NULL,
    metric_type VARCHAR(50) NOT NULL,
    tags JSONB,
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS kotlin.alert (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    alert_name VARCHAR(255) NOT NULL,
    alert_type VARCHAR(100) NOT NULL,
    severity VARCHAR(50) NOT NULL,
    condition TEXT NOT NULL,
    description TEXT,
    status VARCHAR(50) DEFAULT 'active',
    enabled BOOLEAN DEFAULT true,
    triggered_at TIMESTAMP,
    resolved_at TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- File table
CREATE TABLE IF NOT EXISTS kotlin.file_metadata (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    file_name VARCHAR(255) NOT NULL,
    file_size BIGINT NOT NULL,
    mime_type VARCHAR(100),
    file_path TEXT NOT NULL,
    storage_provider VARCHAR(50) DEFAULT 'local',
    status VARCHAR(50) DEFAULT 'uploaded',
    metadata JSONB,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Poll table
CREATE TABLE IF NOT EXISTS kotlin.poll_survey (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    title VARCHAR(255) NOT NULL,
    description TEXT,
    poll_type VARCHAR(50) DEFAULT 'survey',
    status VARCHAR(50) DEFAULT 'draft',
    questions JSONB NOT NULL,
    responses JSONB DEFAULT '[]',
    start_date TIMESTAMP,
    end_date TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Create indexes
CREATE INDEX idx_notification_user_id ON kotlin.notification(user_id);
CREATE INDEX idx_notification_type ON kotlin.notification(type);
CREATE INDEX idx_notification_status ON kotlin.notification(status);
CREATE INDEX idx_notification_channel_user_id ON kotlin.notification_channel(user_id);
CREATE INDEX idx_notification_channel_type ON kotlin.notification_channel(channel_type);
CREATE INDEX idx_notification_template_code ON kotlin.notification_template(template_code);
CREATE INDEX idx_notification_template_status ON kotlin.notification_template(status);
CREATE INDEX idx_media_folder_parent_id ON kotlin.media_folder(parent_id);
CREATE INDEX idx_media_file_folder_id ON kotlin.media_file(folder_id);
CREATE INDEX idx_media_file_status ON kotlin.media_file(status);
CREATE INDEX idx_payment_user_id ON kotlin.payment(user_id);
CREATE INDEX idx_payment_status ON kotlin.payment(status);
CREATE INDEX idx_payment_refund_of ON kotlin.payment(refund_of);
CREATE INDEX idx_payment_intent_user_id ON kotlin.payment_intent(user_id);
CREATE INDEX idx_payment_intent_status ON kotlin.payment_intent(status);
CREATE INDEX idx_push_queue_user_id ON kotlin.push_queue(user_id);
CREATE INDEX idx_push_queue_status ON kotlin.push_queue(status);
CREATE INDEX idx_push_queue_priority ON kotlin.push_queue(priority);
CREATE INDEX idx_push_queue_scheduled_at ON kotlin.push_queue(scheduled_at);
CREATE INDEX idx_email_queue_user_id ON kotlin.email_queue(user_id);
CREATE INDEX idx_email_queue_status ON kotlin.email_queue(status);
CREATE INDEX idx_email_queue_priority ON kotlin.email_queue(priority);
CREATE INDEX idx_email_queue_scheduled_at ON kotlin.email_queue(scheduled_at);
CREATE INDEX idx_system_metric_name ON kotlin.system_metric(metric_name);
CREATE INDEX idx_system_metric_type ON kotlin.system_metric(metric_type);
CREATE INDEX idx_system_metric_timestamp ON kotlin.system_metric(timestamp);
CREATE INDEX idx_alert_type ON kotlin.alert(alert_type);
CREATE INDEX idx_alert_severity ON kotlin.alert(severity);
CREATE INDEX idx_alert_status ON kotlin.alert(status);
CREATE INDEX idx_alert_enabled ON kotlin.alert(enabled);
CREATE INDEX idx_file_metadata_user_id ON kotlin.file_metadata(user_id);
CREATE INDEX idx_file_metadata_status ON kotlin.file_metadata(status);
CREATE INDEX idx_poll_survey_user_id ON kotlin.poll_survey(user_id);
CREATE INDEX idx_poll_survey_type ON kotlin.poll_survey(poll_type);
CREATE INDEX idx_poll_survey_status ON kotlin.poll_survey(status);

-- Create triggers for updated_at
CREATE OR REPLACE FUNCTION kotlin.update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ language 'plpgsql';

CREATE TRIGGER update_notification_channel_updated_at BEFORE UPDATE ON kotlin.notification_channel
    FOR EACH ROW EXECUTE FUNCTION kotlin.update_updated_at_column();

CREATE TRIGGER update_notification_template_updated_at BEFORE UPDATE ON kotlin.notification_template
    FOR EACH ROW EXECUTE FUNCTION kotlin.update_updated_at_column();

CREATE TRIGGER update_media_folder_updated_at BEFORE UPDATE ON kotlin.media_folder
    FOR EACH ROW EXECUTE FUNCTION kotlin.update_updated_at_column();

CREATE TRIGGER update_media_file_updated_at BEFORE UPDATE ON kotlin.media_file
    FOR EACH ROW EXECUTE FUNCTION kotlin.update_updated_at_column();

CREATE TRIGGER update_payment_updated_at BEFORE UPDATE ON kotlin.payment
    FOR EACH ROW EXECUTE FUNCTION kotlin.update_updated_at_column();

CREATE TRIGGER update_payment_intent_updated_at BEFORE UPDATE ON kotlin.payment_intent
    FOR EACH ROW EXECUTE FUNCTION kotlin.update_updated_at_column();

CREATE TRIGGER update_push_queue_updated_at BEFORE UPDATE ON kotlin.push_queue
    FOR EACH ROW EXECUTE FUNCTION kotlin.update_updated_at_column();

CREATE TRIGGER update_email_queue_updated_at BEFORE UPDATE ON kotlin.email_queue
    FOR EACH ROW EXECUTE FUNCTION kotlin.update_updated_at_column();

CREATE TRIGGER update_alert_updated_at BEFORE UPDATE ON kotlin.alert
    FOR EACH ROW EXECUTE FUNCTION kotlin.update_updated_at_column();

CREATE TRIGGER update_file_metadata_updated_at BEFORE UPDATE ON kotlin.file_metadata
    FOR EACH ROW EXECUTE FUNCTION kotlin.update_updated_at_column();

CREATE TRIGGER update_poll_survey_updated_at BEFORE UPDATE ON kotlin.poll_survey
    FOR EACH ROW EXECUTE FUNCTION kotlin.update_updated_at_column();
