CREATE INDEX idx_service_review_booking_id ON php.service_review(booking_id);

-- Create triggers for updated_at
CREATE OR REPLACE FUNCTION php.update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ language 'plpgsql';

CREATE TRIGGER update_user_updated_at BEFORE UPDATE ON php.user
    FOR EACH ROW EXECUTE FUNCTION php.update_updated_at_column();

CREATE TRIGGER update_device_token_updated_at BEFORE UPDATE ON php.device_token
    FOR EACH ROW EXECUTE FUNCTION php.update_updated_at_column();

CREATE TRIGGER update_oauth_provider_updated_at BEFORE UPDATE ON php.oauth_provider
    FOR EACH ROW EXECUTE FUNCTION php.update_updated_at_column();

