#!/usr/bin/env python3
"""Zig quality gate: build test, release-safe build"""
import subprocess
import sys
import os

project_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(project_root)

print("🔍 Running Zig quality gate...")

# 1. Run tests
print("  → zig build test...")
result = subprocess.run(["cd", "zig", "&&", "zig", "build", "test"], shell=True, capture_output=False)
if result.returncode != 0:
    print("❌ Zig tests failed")
    sys.exit(1)

# 2. Release-safe build (ensures no warnings/errors in optimized build)
print("  → zig build -Drelease-safe...")
result = subprocess.run(["cd", "zig", "&&", "zig", "build", "-Drelease-safe"], shell=True, capture_output=False)
if result.returncode != 0:
    print("❌ Zig release-safe build failed")
    sys.exit(1)

print("✅ Zig quality gate PASSED")
sys.exit(0)
