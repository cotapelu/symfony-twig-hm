### Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release

### Database
DATABASE_URL=mysql://db_user:db_password@localhost:3306/community_db

### Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

### Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_EVENTS=community-events
KAFKA_TOPIC_PAYMENTS=community-payments
KAFKA_GROUP_ID=go-services

### RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

### Logging
LOG_LEVEL=info
LOG_FORMAT=json

### CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
