### Application Configuration
APP_NAME=Community Python Services
DEBUG=false

### Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4

### Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

### Event Bus
EVENTBUS_ENABLED=true
EVENTBUS_BACKEND=redis

### OpenAI (AI/ML)
OPENAI_API_KEY=CHANGE_THIS_TO_YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000

### Media Upload
MEDIA_UPLOAD_DIR=./uploads
MEDIA_MAX_FILE_SIZE=10485760
MEDIA_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,mp3,mp4

### Logging
LOG_LEVEL=info
LOG_FORMAT=json

### CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
