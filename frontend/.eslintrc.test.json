{
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "plugins": ["import"],
  "rules": {
    "import/no-restricted-paths": [
      "error",
      {
        "zones": [
          {
            "from": "*/state/*",
            "target": "*/ui/*",
            "message": "State layer should not import from UI layer."
          }
        ]
      }
    ],
    "*": "off"
  }
}
